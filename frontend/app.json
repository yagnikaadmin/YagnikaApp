{
  "expo": {
    "name": "frontend",
    "slug": "frontend",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "frontend",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.emergent.yagnikafirestore.gjsbb9"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#000000"
      },
      "package": "com.emergent.yagnikafirestore.gjsbb9"
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/yagnika/splash-screen.png",
          "resizeMode": "cover",
          "backgroundColor": "#1A0D08",
          "dark": {
            "image": "./assets/yagnika/splash-screen.png",
            "resizeMode": "cover",
            "backgroundColor": "#1A0D08"
          }
        }
      ],
      "expo-localization",
      "expo-font",
      "expo-image",
      "expo-secure-store",
      "expo-status-bar",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "9256c849-56b9-43c3-945d-69bd358d3e44"
      }
    }
  }
}
